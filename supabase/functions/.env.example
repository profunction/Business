# 本机 `supabase functions serve` 用：复制成 supabase/functions/.env 再填值（.env 不要放进 git）。
# 正式环境用 `supabase secrets set NAME=value`。名字不能以 SUPABASE_ 开头。
FCM_SERVICE_ACCOUNT_JSON=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v27.0
ANTHROPIC_API_KEY=
# 免费方案（总时间 150 秒）设 140000；付费方案（400 秒）不用设
# PRICE_LIST_TIME_BUDGET_MS=140000
